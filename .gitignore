# ─── Dependencies ───────────────────────────────────────────
node_modules/
jspm_packages/
.npm
.pnp
.pnp.js

# ─── Lock files (host installs from package.json) ───────────
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Runtime data (lives on the server volume, not the repo) ─
data/
*.roster.json
events.json
pids/
*.pid
*.seed
*.pid.lock

# ─── Secrets & environment (never commit real values) ───────
.env
.env.*
!.env.example
*.key
*.pem

# ─── Caches & build output ──────────────────────────────────
.cache/
.tmp/
tmp/
dist/
build/
coverage/
.nyc_output/
.eslintcache

# ─── Editors & IDEs ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ─── OS junk ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
