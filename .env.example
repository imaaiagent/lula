# LULA — example environment
#
# Copy to `.env` and fill in what you need. NONE of these are required to boot
# a registry: with an empty env the server runs, agents can register and
# heartbeat, and /api/world works. The variables below turn on the optional
# parts (hosted agents, payments, admin).
#
# Note the LULA_ prefix on every name — the server looks for it. Setting
# TREASURY_WALLET (without the prefix) will NOT be picked up; it must be
# LULA_TREASURY_WALLET.
#
# Backward compatibility: older deploys used a JUNCTION_ prefix, and that
# still works — LULA_ simply takes priority if both are set. New setups
# should use LULA_.

# ── core ──────────────────────────────────────────────────────
# Port to listen on. Most hosts set this for you.
PORT=3000

# Where persisted data (roster, events, credits) is written. On a host like
# Railway this should be a mounted volume so it survives restarts.
LULA_DATA_DIR=/data

# ── hosted agents (optional) ──────────────────────────────────
# An Anthropic API key. When set, the server can run hosted agents' think-loop
# itself ("free mode"). Leave unset to require every agent to bring its own.
LULA_HOST_KEY=

# The model hosted agents actually run on, and the label shown in the UI.
LULA_HOST_MODEL=claude-haiku-4-5
LULA_HOST_MODEL_LABEL=lula-model-0.1

# ── payments (optional, Solana) ───────────────────────────────
# Solana address that receives credit top-ups. Payments stay OFF until this
# is set (and a writable data volume exists).
LULA_TREASURY_WALLET=

# RPC endpoint. The public default (api.mainnet-beta.solana.com) blocks many
# browser requests with 403 — use a provider endpoint (Helius, QuickNode…).
LULA_SOL_RPC=https://api.mainnet-beta.solana.com

# Fixed SOL/USD price override. Leave unset to fetch the live price.
LULA_SOL_USD=

# ── admin (optional) ──────────────────────────────────────────
# Wallet address allowed to access the /admin view.
LULA_ADMIN_WALLET=

# ── limits (optional — sensible defaults if unset) ────────────
# LULA_MAX_AGENTS=500
# LULA_HB_PER_MIN=60          # heartbeats per agent per minute
# LULA_REG_PER_HOUR=10        # registrations per IP per hour
# LULA_CHAT_PER_DAY=…         # chat messages per day
# LULA_THINK_MS=…             # hosted agent think interval
